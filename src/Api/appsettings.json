{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },

  "OpenApi": {
    "Title": "HamroSavings API",
    "Description": "API for managing savings groups, members, loans, and finances.",
    "Version": "v1"
  },

  "ConnectionStrings": {
    "HamroSavingsDb": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "HamroSavings",
    "Audience": "HamroSavings",
    "ExpirationInMinutes": 1440
  },

  "SuperAdmin": {
    "Email": "",
    "Password": "",
    "FirstName": "Super",
    "LastName": "Admin"
  },

  "Frontend": {
    "Url": "http://localhost:5173"
  },

  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "SignIn": { "PermitLimit": 15, "WindowSeconds": 300 },
    "AccountRecovery": { "PermitLimit": 5, "WindowSeconds": 900 }
  },

  "Email": {
    "SmtpHost": "",
    "SmtpPort": "",
    "Username": "",
    "Password": "",
    "FromAddress": ""
  }
}
